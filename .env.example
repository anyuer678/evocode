# EvoCode 环境变量模板（复制为 .env 后填写）
# 无 LLM 配置也能跑：报告走规则版降级（source=RULES）

# 数据库（docker-compose 与 backend 共用）
POSTGRES_DB=evocode
POSTGRES_USER=evocode
POSTGRES_PASSWORD=evocode_dev
POSTGRES_URL=jdbc:postgresql://127.0.0.1:5432/evocode

# LLM（OpenAI 兼容接口；留空则走降级）
LLM_API_KEY=
LLM_BASE_URL=http://127.0.0.1:11434/v1        # 本地 ollama 示例
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# RAG 向量化模型（OpenAI 兼容 /embeddings；无 embedding 网关时留空走关键词兜底）
LLM_EMBEDDING_MODEL=bge-m3
# analyzer 直连 PG（只读写 knowledge_chunk 表）；留空 = RAG 向量不可用（关键词兜底）
ANALYZER_PG_DSN=postgresql://evocode:evocode_dev@127.0.0.1:5432/evocode

# 分析服务（仅本机回环）
ANALYZER_URL=http://127.0.0.1:8081
DATA_DIR=data

# Sonar（P3 阶段启用；sonarqube 容器在 --profile full 下）
SONAR_HOST_URL=http://127.0.0.1:9000
SONAR_TOKEN=

# 服务端口（与 README 约定一致：backend 18080，避开本机 polycode-gateway 的 8080）
BACKEND_PORT=18080
FRONTEND_PORT=5173
